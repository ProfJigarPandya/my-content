chown -R 1000:100   /var/lib/docker/volumes/docker-dfs-name/
chmod -R u+rwX,g+rwX   /var/lib/docker/volumes/docker-dfs-name
chmod -R u+rwX,g+rwX   /var/lib/docker/volumes/docker-dfs-data
chown -R 1000:100  /var/lib/docker/volumes/docker-dfs-data

First run
command: ["/bin/bash", "-c", "if [ ! -d /tmp/hadoop-hadoop/dfs/name/current ]; then hdfs namenode -format; fi && hdfs namenode"]

Second run onward only if format hdfs is required otherwise have below
      command: ["hdfs", "namenode"]


