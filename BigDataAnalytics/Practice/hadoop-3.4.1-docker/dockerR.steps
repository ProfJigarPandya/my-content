https://hub.docker.com/r/apache/hadoop
docker pull apache/hadoop:3.4.1

https://hub.docker.com/r/apache/hadoop


docker run -it apache/hadoop:3.4.1 bash



Here are the common ports for Hadoop 3.x components that you might need to expose:

    HDFS NameNode:
        9870: HDFS NameNode Web UI (default)
        8020: HDFS NameNode RPC (default) 
    HDFS DataNode:
        9864: HDFS DataNode Web UI (default)
        9866: HDFS DataNode Data Transfer Protocol (default) 
    YARN ResourceManager:
        8088: YARN ResourceManager Web UI (default)
        8032: YARN ResourceManager RPC (default) 
    YARN NodeManager:
        8042: YARN NodeManager Web UI (default)
        8040: YARN NodeManager Container Management (default) 
    MapReduce JobHistory Server:
        19888: MapReduce JobHistory Server Web UI (default)

docker run --name hadoop-3.4.1 -p 9870:9870 -p 8020:8020 -p 9864:9864 -p 9866:9866 -p 8088:8088 -p 8032:8332 -p 8042:8042 -p 8040:8040 -p 19888:19888 apache/hadoop:3.4.1


#docker rm hadoop-3.4.1

docker start hadoop-3.4.1

docker-compose up -d


docker update --restart unless-stopped hadoop-3.4.1

