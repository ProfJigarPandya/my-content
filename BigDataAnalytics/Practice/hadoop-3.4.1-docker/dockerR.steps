docker volume ls

 1055  tree shared_*
 1056  echo "This is Namenode" > shared_nn/nn.txt
 1057  echo "This is Datanode" > shared_dn/dn.txt
 1058  echo "This is Resourcemanager" > shared_rm/rm.txt
 1059  echo "This is Nodemanager" > shared_nm/nm.txt
 1060  tree shared_*


docker volume create namenode_data
docker volume create datanode_data

docker run -d \
      -v namenode_data:/tmp/hadoop-root/dfs/name:rw \
      --name namenode_container \
      apache/hadoop:3.4.1

    docker run -d \
      -v datanode_data:/tmp/hadoop-root/dfs/data:rw \
      --name datanode_container \
      apache/hadoop:3.4.1
      
      
