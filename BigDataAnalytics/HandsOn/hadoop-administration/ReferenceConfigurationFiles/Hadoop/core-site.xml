<!-- Put site-specific property overrides in this file. -->

<configuration>
<property>
  <name>hadoop.tmp.dir</name>
  <value>/usr/local/jmpandya/tmp</value>
  <description>A base for other temporary directories.</description>
</property>
<property>
  <name>fs.defaultFS</name>
  <value>hdfs://jmpfedora:9000</value>
  <description>The name of the default file system. A URI whose scheme and authority determine the
  FileSystem implementation. The uri's scheme determines the config property (fs.SCHEME.impl) that
  defines the FileSystem implementation. The uri's authority is used to determine the host, port, etc. for a
  filesystem.</description>
</property>
<property>
  <name>file.replication</name>
  <value>1</value>
</property>            
<property>
  <name>hadoop.http.staticuser.user</name>
  <value>jmpandya</value>
</property> 
</configuration>
